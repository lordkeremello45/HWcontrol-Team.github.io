---
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  active?: string;
}
const { title, description, active = "" } = Astro.props;
const base = import.meta.env.BASE_URL.endsWith("/") ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + "/";
const mainSite = "https://lordkeremello45.github.io/HWcontrol2.0/";
const nav = [
  ["HWcontrol2.0", mainSite, "hwcontrol"],
  ["Features", mainSite + "#features", "features"],
  ["Security", mainSite + "#security", "security"],
  ["Privacy", mainSite + "privacy/", "privacy"],
  ["Download", mainSite + "#download", "download"]
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#070a10" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <meta http-equiv="Content-Security-Policy" content="default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self'; font-src 'self'; upgrade-insecure-requests" />
    <title>{title}</title>
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href={mainSite} aria-label="HWcontrol2.0 main site">
        <span class="brand-mark">HW</span>
        <span>HWcontrol <strong>Team</strong></span>
      </a>
      <nav aria-label="Primary navigation">
        {nav.map(([label, href, key]) => (
          <a class:list={{ active: active === key }} href={href}>{label}</a>
        ))}
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <span>HWcontrol Team</span>
      <span>Security-first · Local-first · Open source</span>
    </footer>
  </body>
</html>
