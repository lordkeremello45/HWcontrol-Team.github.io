---
import BaseLayout from "../../../layouts/BaseLayout.astro";
---
<BaseLayout title="HWcontrol2.0 — HWcontrol Team" description="Cross-platform hardware monitoring and control." active="projects">
  <section class="hero">
    <div><span class="eyebrow">Project</span><h1>HWcontrol2.0</h1><p class="lead">Cross-platform hardware monitoring and control for Windows, Linux and Apple Silicon macOS.</p><div class="actions"><a class="button primary" href="https://lordkeremello45.github.io/HWcontrol2.0/">Open HWcontrol2.0 ↗</a><a class="button" href="https://lordkeremello45.github.io/HWcontrol2.0/#download">Downloads ↗</a><a class="button" href="https://github.com/lordkeremello45/HWcontrol2.0">Source</a></div></div>
  </section>
  <section class="card section"><span class="pill">Architecture</span><div class="arch"><div>Flutter / Dart<br><small class="muted">GUI</small></div><div>Go<br><small class="muted">Authenticated bridge</small></div><div>C++ / CMake<br><small class="muted">Native engine</small></div><div>Platform APIs<br><small class="muted">Hardware</small></div></div></section>
  <section class="grid section">
    <article class="card"><h2>Windows</h2><p>Windows 10/11 x64.</p></article>
    <article class="card"><h2>Linux</h2><p>Linux x64.</p></article>
    <article class="card"><h2>macOS</h2><p>macOS 14+ Apple Silicon.</p></article>
  </section>
</BaseLayout>
